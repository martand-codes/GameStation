generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  PLAYER
  DEVELOPER
  ADMIN
  OWNER
}

// For GameStatus
enum GameStatus {
  DRAFT
  PENDING
  REJECTED
  PUBLISHED
  HIDDEN
}

model User {
  id            String                        @id @default(uuid())
  email         String                        @unique
  username      String                        @unique
  password      String                                    
  role          Role                          @default(PLAYER)
  isActive      Boolean                       @default(true)

  // Phase 2
  games         Game[]                        @relation("DeveloperGames")
  sessions      Session[]  // To keep track at all the sessions of the user

  // Phase 3 Payment Integration
  payments      Payment[]
  library       UserLibrary[]
  reviews       GameReview[]
  reviewVotes   GameReviewVote[]

  // Admin & Staff Governance
  reviewedGames         Game[]          @relation("AdminReviewedGames")
  assignedGameReviews   Game[]          @relation("AssignedGameReviews")
  createdInvites        StaffInvite[]   @relation("StaffInvitesCreated")
  recoveryPhraseHash    String?
  securityQuestions     String?

  // For Wallet
  walletBalance         Decimal                         @default(0.00)
  walletTransactions    Wallet[]

  // Friends & Social Network
  sentFriendships       Friendship[]                    @relation("SentFriendships")
  receivedFriendships   Friendship[]                    @relation("ReceivedFriendships")
  sentMessages          DirectMessage[]                 @relation("SentMessages")
  receivedMessages      DirectMessage[]                 @relation("ReceivedMessages")

  // Saga Distributed Transactions
  sagas                 SagaInstance[]

  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt      
}


model Session {
  id                String                      @id @default(uuid())
  refreshToken      String                      @unique
  userId            String
  user              User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceType        String                      @default("DESKTOP") // "DESKTOP" | "MOBILE"
  deviceName        String?                     @default("Desktop Computer")
  createdAt         DateTime                    @default(now())
  expiresAt         DateTime   
  
}



// For Game Engine
model Game {
  id                   String            @id @default(uuid())
  title                String 
  genre                String 
  description          String            // For large texts
  tags                 String[]

  status               GameStatus        @default(DRAFT)
  developerId          String
  developer            User              @relation("DeveloperGames", fields: [developerId], references: [id])

  // Normalization
  pricing              GamePricing[]
  media                GameMedia?
  versions             GameVersion[]
  requirements         GameRequirements?
  telemetry            GameTelemetry?

  // Phase 3 Payment Integration
  payments             Payment[]
  library              UserLibrary[]
  reviews              GameReview[]

  // Moderation & Review Audit
  rejectionReason      String?
  reviewedByAdminId    String?
  reviewedByAdmin      User?             @relation("AdminReviewedGames", fields: [reviewedByAdminId], references: [id])
  reviewedAt           DateTime?

  // Module 1: Task Assignment & Claim Lock Engine
  assignedAdminId      String?
  assignedAdmin        User?             @relation("AssignedGameReviews", fields: [assignedAdminId], references: [id])
  assignedAt           DateTime?
  qaNotes              String?

  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt 



}

model GamePricing {
  id                   String             @id @default(uuid())
  gameId               String
  game                 Game               @relation(fields: [gameId], references: [id], onDelete: Cascade)
  editionName          String             @default("Standard Edition")
  features             String[]           @default([])
  isFree               Boolean            @default(false)
  price                Decimal
  currency             String             @default("INR")
  discounts            GameDiscount[]

  // Phase 3 Payment Integration
  payments             Payment[]
  libraryItems         UserLibrary[]
  
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt 
}

model GameDiscount {
  id                   String             @id @default(uuid())

  pricingId            String
  pricing              GamePricing        @relation(fields: [pricingId], references: [id], onDelete: Cascade)
  percentage  Decimal

  startsAt             DateTime
  endsAt               DateTime
  createdAt            DateTime  @default(now())
}

model GameMedia {
  id                   String             @id @default(uuid())
  gameId               String             @unique
  game                 Game               @relation(fields: [gameId], references: [id], onDelete: Cascade)

  coverImageUrl        String?
  bannerImageUrl       String?
  screenshots          String[]
  trailerUrl           String?

  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt 
}

model GameVersion {
  id                   String             @id @default(uuid())
  gameId               String
  game                 Game               @relation(fields: [gameId], references: [id], onDelete: Cascade)
  version              String             
  downloadUrl          String?
  changelog            String?
  createdAt            DateTime  @default(now())
  @@unique([gameId, version])
}

model GameRequirements {
  id                   String             @id @default(uuid())
  gameId               String             @unique
  game                 Game               @relation(fields: [gameId], references: [id], onDelete: Cascade)
  
  // Bare Metal Minimum
  minOs                String
  minCpu               String
  minGpu               String
  minMem               String
  minStorage           String
  minNetwork           String

  // Optimal Yield (Enjoyable)
  optOs                String
  optCpu               String
  optGpu               String
  optMem               String
  optStorage           String
  optNetwork           String

  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt 
}

model GameTelemetry {
  id                 String             @id @default(uuid())
  gameId             String             @unique
  game               Game               @relation(fields: [gameId], references: [id], onDelete: Cascade)
  
  mainStoryHours     Float?
  mainExtrasHours    Float?
  completionistHours Float?

  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt 
}

// For Payment Integration
enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

model Payment {
  id                String         @id @default(uuid())
  userId            String
  user              User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  gameId            String
  game              Game           @relation(fields: [gameId], references: [id], onDelete: Cascade)
  pricingId         String
  pricing           GamePricing    @relation(fields: [pricingId], references: [id], onDelete: Cascade)
  
  status            PaymentStatus  @default(PENDING)
  amount            Decimal
  currency          String         @default("INR")
  provider          String         @default("stripe")
  
  providerSessionId String?        @unique // Stripe Checkout Session ID (cs_test_...)
  providerPaymentId String?        @unique // Stripe PaymentIntent ID (pi_...)

  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
}

model UserLibrary {
  id        String       @id @default(uuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  gameId    String
  game      Game         @relation(fields: [gameId], references: [id], onDelete: Cascade)
  pricingId String?
  pricing   GamePricing? @relation(fields: [pricingId], references: [id], onDelete: SetNull)
  
  // For Tracking What's Played
  playTime    Int            @default(0)    // In seconds
  lastPlayed  DateTime?     

  createdAt DateTime     @default(now())

  @@unique([userId, gameId])
}


// Wallet model

enum WalletTransactionType {
  TOP_UP
  GAME_PURCHASE
  REFUND
  BONUS
}

model Wallet {
  id              String                  @id @default(uuid())
  userId          String                  
  user            User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount          Decimal
  type            WalletTransactionType   
  description     String?   
  referenceId     String?                

  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt 
}

// Staff Onboarding & Admin Invites
model StaffInvite {
  id          String    @id @default(uuid())
  token       String    @unique
  role        Role      @default(ADMIN)
  createdById String
  createdBy   User      @relation("StaffInvitesCreated", fields: [createdById], references: [id], onDelete: Cascade)
  isUsed      Boolean   @default(false)
  usedByEmail String?
  expiresAt   DateTime
  createdAt   DateTime  @default(now())
}

// Governance Flight Recorder
model GovernanceAuditLog {
  id          String    @id @default(uuid())
  action      String    // e.g. "ROOT_CLAIMED", "STAFF_INVITED", "STAFF_ACCEPTED", "STAFF_REVOKED", "BREAK_GLASS_TRIGGERED"
  actorId     String?
  actorName   String?
  targetId    String?
  targetName  String?
  details     String?
  ipAddress   String?
  createdAt   DateTime  @default(now())
}

// Player Reviews & Deep-Dive Telemetry Matrix
model GameReview {
  id                   String    @id @default(uuid())
  gameId               String
  game                 Game      @relation(fields: [gameId], references: [id], onDelete: Cascade)
  userId               String
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Core Rating
  overallRating        Int       // 1 to 5 (1=Broken, 2=Flawed, 3=Meh, 4=Great, 5=Masterpiece)
  headline             String?   // Concise 1-liner summary
  content              String    // Detailed player review / feedback

  // Deep-Dive Categorical Sub-scores (Optional 1 to 5 scale)
  optimization         Int?      // 1-5 Performance & Frame Pacing
  funFactor            Int?      // 1-5 Gameplay Loop & Enjoyment
  soundDesign          Int?      // 1-5 Audio, OST, Sound FX
  visuals              Int?      // 1-5 Graphics, Art Direction
  stabilityNetcode     Int?      // 1-5 Bugs, Crashes, Online Connectivity

  // Authenticity & Telemetry Snapshot
  playtimeAtReview     Int       // Exact playtime in seconds when this review was posted
  isVerifiedOwner      Boolean   @default(true)

  // Community Utility (Phase 2 hooks ready)
  helpfulCount         Int              @default(0)
  unhelpfulCount       Int              @default(0)
  votes                GameReviewVote[]

  // Studio Response (Phase 3 hooks ready)
  developerResponse    String?
  developerRespondedAt DateTime?

  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  @@unique([userId, gameId])
  @@index([gameId])
  @@index([userId])
}

// Community Review Helpful/Unhelpful Votes
model GameReviewVote {
  id        String      @id @default(uuid())
  reviewId  String
  review    GameReview  @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  isHelpful Boolean     // true for Helpful (👍), false for Unhelpful (👎)

  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@unique([userId, reviewId])
  @@index([reviewId])
  @@index([userId])
}

// ── Friends & Live Social Network ─────────────────────────────────────────────

enum FriendshipStatus {
  PENDING
  ACCEPTED
  DECLINED
  BLOCKED
}

model Friendship {
  id          String           @id @default(uuid())
  senderId    String
  sender      User             @relation("SentFriendships", fields: [senderId], references: [id], onDelete: Cascade)
  receiverId  String
  receiver    User             @relation("ReceivedFriendships", fields: [receiverId], references: [id], onDelete: Cascade)
  status      FriendshipStatus @default(PENDING)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@unique([senderId, receiverId])
  @@index([senderId])
  @@index([receiverId])
}

model DirectMessage {
  id          String    @id @default(uuid())
  senderId    String
  sender      User      @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  receiverId  String
  receiver    User      @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)
  content     String    @db.Text
  isRead      Boolean   @default(false)
  createdAt   DateTime  @default(now())

  @@index([senderId, receiverId])
  @@index([createdAt])
}

// ── Saga Distributed Transactions Engine ───────────────────────────────────────

enum SagaStatus {
  PENDING
  RUNNING
  COMPLETED
  COMPENSATING
  COMPENSATED
  FAILED
}

enum SagaStepStatus {
  PENDING
  RUNNING
  SUCCESS
  FAILED
  COMPENSATING
  COMPENSATED
  SKIPPED
}

model SagaInstance {
  id              String         @id @default(uuid())
  sagaType        String         // e.g. "GAME_PURCHASE"
  idempotencyKey  String         @unique
  userId          String?
  user            User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  status          SagaStatus     @default(PENDING)
  currentStep     Int            @default(0)
  totalSteps      Int            @default(0)
  payload         Json           // input parameters (gameId, pricingId, cost, etc.)
  error           String?        @db.Text
  durationMs      Int?
  startedAt       DateTime       @default(now())
  completedAt     DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  steps           SagaStepLog[]

  @@index([userId])
  @@index([status])
  @@index([sagaType])
  @@index([idempotencyKey])
}

model SagaStepLog {
  id              String         @id @default(uuid())
  sagaId          String
  saga            SagaInstance   @relation(fields: [sagaId], references: [id], onDelete: Cascade)
  stepIndex       Int
  stepName        String
  status          SagaStepStatus @default(PENDING)
  input           Json?
  output          Json?
  error           String?        @db.Text
  durationMs      Int?
  compensatedAt   DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@unique([sagaId, stepIndex])
  @@index([sagaId])
  @@index([status])
}


